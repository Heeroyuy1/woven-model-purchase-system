# Railway sets DATABASE_URL and PORT automatically.
# Copy these variables into the Railway dashboard (Variables tab).

PORT=3001
JWT_SECRET=change-this-to-a-random-secret-in-production
LICENSING_API_URL=https://woven-licensing-production.up.railway.app/api/v1
LICENSING_API_KEY=your-licensing-api-key

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Use sk_test_ / pk_test_ while testing, sk_live_ / pk_live_ in production.
# Both keys MUST be from the same mode or the server refuses to start.
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
# Stripe > Developers > Webhooks > your endpoint > Signing secret.
# Endpoint URL: https://<your-store-domain>/api/webhooks/stripe
# Events: payment_intent.succeeded, payment_intent.payment_failed,
#         charge.refunded, charge.dispute.created
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret

# ─── Email (SMTP2GO) ─────────────────────────────────────────────────────────
# SMTP Server: mail.smtp2go.com | Ports: 2525 (STARTTLS), 465 (SSL), 8025/587/80/25
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=wovenmodel.com
SMTP_PASS=your-smtp2go-password
SMTP_FROM=ceo@wovenmodel.com
SMTP_REPLY_TO=sales@wovenmodel.com

FRONTEND_URL=https://heeroyuy1.github.io
CORS_ORIGINS=https://heeroyuy1.github.io,http://localhost:5173
TAX_RATE=0.0
ADMIN_EMAIL=admin@wovenmodel.com
ADMIN_PASSWORD=change-this-admin-password

# Database backup recipient — a full gzipped JSON backup of all tables is
# emailed daily (plus 60s after each deploy) and on demand via
# POST /api/admin/backup (admin auth required).
BACKUP_EMAIL=ceo@wovenmodel.com

# Internal "new sale" notification: sent every time an order is completed,
# with the items, totals, customer, payment intent and license keys.
PURCHASE_NOTIFICATION_EMAIL=ceo@wovenmodel.com
